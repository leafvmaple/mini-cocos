{
    "cSpell.words": [
        "glfw",
        "zocos",
        "ZCDirector",
        "ZCNode",
        "ZCScene",
        "ZCSprite",
        "ZCMat",
        "ZCVec",
        "GLbitfield",
        "GLboolean",
        "GLchar",
        "GLenum",
        "GLfloat",
        "GLint",
        "GLintptr",
        "GLuint",
        "GLsizei",
        "GLsizeiptr",
        "GL_FALSE",
        "GL_TRUE",
        "GL_TRIANGLES",
        "GL_TEXTURE_2D",
        "GL_BLEND",
        "GL_SRC_ALPHA",
        "GL_ONE_MINUS_SRC_ALPHA",
        "GL_ARRAY_BUFFER",
        "GL_ELEMENT_ARRAY_BUFFER",
        "GL_STATIC_DRAW",
        "GL_FRAGMENT_SHADER",
        "GL_VERTEX_SHADER",
        "GL_COMPILE_STATUS",
        "GL_LINK_STATUS",
        "GL_INFO_LOG_LENGTH",
        "GL_TEXTURE0",
        "GL_RGBA",
        "GL_UNSIGNED_BYTE",
        "GL_LINEAR",
        "GL_CLAMP_TO_EDGE",
        "GL_COLOR_BUFFER_BIT",
        "GL_DEPTH_BUFFER_BIT",
        "GL_TEXTURE_MIN_FILTER",
        "GL_TEXTURE_MAG_FILTER",
        "GL_TEXTURE_WRAP_S",
        "GL_TEXTURE_WRAP_T",
        "GL_FLOAT"
    ],
    "C_Cpp.intelliSenseEngine": "disabled",
    "editor.formatOnSave": true,
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[cuda-cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "clangd.arguments": [
        "--background-index",
        "--query-driver=C:/Program Files/Microsoft Visual Studio/*/VC/Tools/MSVC/*/bin/Hostx64/x64/cl.exe,C:/PROGRA~1/MICROS~1/*/VC/Tools/MSVC/*/bin/Hostx64/x64/cl.exe,C:/Program Files/LLVM/bin/clang-cl.exe"
    ],
    "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json"
}