# Used when compile_commands.json is absent or incomplete (e.g. MSVC generator).
# When build/compile_commands.json exists (CMake + Ninja / Makefile), clangd merges it.
CompileFlags:
  Add:
    - -Isrc
    - -Ithird_party
    - -std=c++17
    - -DNOMINMAX
    - -DWIN32_LEAN_AND_MEAN

Diagnostics:
  UnusedIncludes: None

Index:
  Background: Build
